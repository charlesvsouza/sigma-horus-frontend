generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lodge {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active")
  // Dados comerciais (loja = PJ sem fins lucrativos com CNPJ)
  legalName    String?  // Razão Social
  tradeName    String?  // Nome Fantasia
  cnpj         String?
  // Identidade visual: brasão da loja, exibido em relatórios, recibos e
  // demais documentos gerados/enviados (e no cabeçalho HTML dos e-mails).
  crestUrl        String?
  crestStorageKey String?
  email        String?
  phone        String?
  addressLine  String?
  addressNumber String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?
  // Dados bancários
  bankName     String?
  bankAgency   String?
  bankAccount  String?
  pixKey       String?
  // Identidade maçônica (escolhida no onboarding / editável nas configurações)
  riteName     String?  // rito praticado (define os cargos da loja)
  powerName    String?  // potência / obediência à qual a loja é filiada
  foundationDate DateTime? // data de fundação — dispara mensagem comemorativa automática no aniversário
  // Agenda padrão de sessões
  sessionWeekdays  String?  // dias da semana: índices 0=Dom..6=Sáb separados por vírgula (ex.: "2,4")
  sessionFrequency String?  @default("weekly") // weekly | biweekly | monthly
  // Aprovação de despesa (visto do Venerável): contas a pagar com valor >= este
  // limite nascem "pending" e só podem ser pagas após aprovação. null = desativado.
  expenseApprovalThreshold Float?
  // Multa/juros de mora sobre mensalidade em atraso (informativo — não altera o
  // valor lançado; usado no relatório de inadimplência e na renegociação).
  lateFeePercent           Float? // multa única, ex.: 2 = 2%
  lateInterestPercentMonth Float? // juros ao mês, pro-rata por dia, ex.: 1 = 1%/mês
  // Emite automaticamente o balancete do mês anterior no dia 1 (cron mensal).
  autoBalanceteEnabled     Boolean @default(false)
  // Aplica a régua automática do Art. 002 (afastamento por mensalidade em
  // atraso > 60 dias). Default true preserva o comportamento de hoje; o
  // relatório de inadimplência continua disponível mesmo com o flag desligado.
  art002Enabled            Boolean @default(true)
  // Mensagens automáticas diárias (cron daily-notifications) — cada categoria
  // liga/desliga independente. Default true preserva o comportamento de hoje
  // (loja com canal ativo já recebia tudo, sem opção de desligar por categoria).
  notifyBirthdaysEnabled      Boolean @default(true) // aniversário do obreiro e de familiares (mãe/pai/cônjuge/dependentes)
  notifyMilestonesEnabled     Boolean @default(true) // jubileus: iniciação, elevação, exaltação e tempo de mestre (anos de Ordem)
  notifyBillingRemindersEnabled Boolean @default(true) // lembrete de cobrança a vencer/vencida
  notifyFoundationAnniversaryEnabled Boolean @default(true) // aniversário de fundação da loja (mensagem a todos os ativos)
  // Asaas (BYO-key): cada loja conecta a própria conta. Chave criptografada (AES-256-GCM).
  asaasApiKeyEnc    String?
  asaasEnv          String?  @default("sandbox") // sandbox | production
  asaasWebhookToken String?  // token p/ validar o webhook do Asaas desta loja
  // Mensageria BYO por loja (WhatsApp/SMS): credenciais próprias da loja, custo direto dela.
  // E-mail é provido pela plataforma (Resend). Tokens criptografados (AES-256-GCM).
  whatsappPhoneId      String?
  whatsappTokenEnc     String?
  whatsappTemplate     String?  // nome do template aprovado (envio proativo)
  whatsappTemplateLang String?  @default("pt_BR")
  smsAccountSid        String?  // Twilio Account SID
  smsAuthTokenEnc      String?
  smsFrom              String?  // número/remetente Twilio
  terminatedAt DateTime? @db.Timestamptz(6) // data de encerramento; aciona purge automático após 90d
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  members       Member[]
  accounts      Account[]
  payments      Payment[]
  auditLogs     AuditLog[]
  rites         Rite[]
  powers        Power[]
  invoices      Invoice[]
  subscription  Subscription?
  sessions      Session[]
  terms         Term[]
  offices       Office[]
  cashCloses    CashClose[]
  balancetes    Balancete[]
  budgets       Budget[]
  assets           Asset[]
  bankTransactions BankTransaction[]
  attendances   Attendance[]
  memberOffices MemberOffice[]
  documents     Document[]
  messageLogs   MessageLog[]
  chartAccounts ChartAccount[]
  rolePermissions RolePermission[]
  relatives     Relative[]
  campaigns     Campaign[]
  campaignDonations CampaignDonation[]
  counterparties Counterparty[]
  hospitalityRequests HospitalityRequest[]
  financialAccounts FinancialAccount[]
  accountTransfers  AccountTransfer[]
  materials     Material[]
  materialLoans MaterialLoan[]
  venerableGalleryEntries VenerableGalleryEntry[]
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("admin")
  lodgeId       String
  status        String   @default("active")
  memberId      String?  @unique // vínculo 1-1 com o cadastro de membro (acesso do obreiro)
  mustChangePassword Boolean @default(false) // força troca da senha provisória no 1º acesso
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lodge         Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  auditLogs     AuditLog[]
}

model Member {
  id                 String   @id @default(cuid())
  lodgeId            String
  name               String
  email              String?
  phone              String?
  status             String   @default("active")
  deceased           Boolean  @default(false) // falecido — exclui de felicitações de aniversário/jubileu automáticas
  duesExempt         Boolean  @default(false) // isento de mensalidade (ex.: Maçom Remido) — fora da cobrança em massa e do Art. 002
  riteId             String?
  powerId            String?
  originPowerId      String?  // potência de origem (bloco "Origem"), distinta da potência atual
  gradeName          String?  // DEPRECADO: situação simbólica é derivada da evolução (ver lib/masonic-degree)
  birthDate          DateTime?
  cpf                String?
  rg                 String?
  maritalStatus      String?
  spouseName         String?
  spouseBirthDate    DateTime?
  childrenNames      String?
  fatherName         String?
  motherName         String?
  occupation         String?
  nationality        String?
  addressLine        String?
  addressNumber      String?
  complement         String?
  neighborhood       String?
  city               String?
  state              String?
  zipCode            String?
  country            String?
  initiationDate     DateTime?
  elevationDate      DateTime?
  exaltationDate     DateTime?
  installationDate   DateTime?
  initiationLodge    String?
  elevationLodge     String?
  exaltationLodge    String?
  installationLodge  String?
  initiationDegree   String?  // DEPRECADO: iniciação é sempre o 1º grau
  currentDegree      String?  // Grau Filosófico atual (REAA 4–33), opcional; vazio = situação simbólica
  originLodge        String?  // Loja de origem (texto) — bloco "Origem"
  masonicNumber      String?
  documents          String?
  notes              String?
  asaasCustomerId    String?  // id do cliente no Asaas da loja (evita recriar a cada cobrança)
  // Foto do irmão: usada na Galeria de Veneráveis (entrada automática) e no
  // Quadro da Gestão. Bucket R2 público dedicado (nunca o de Documentos).
  photoUrl           String?
  photoStorageKey    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lodge              Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  rite               Rite?    @relation(fields: [riteId], references: [id], onDelete: SetNull)
  power              Power?   @relation("MemberPower", fields: [powerId], references: [id], onDelete: SetNull)
  originPower        Power?   @relation("MemberOriginPower", fields: [originPowerId], references: [id], onDelete: SetNull)
  accounts           Account[]
  payments           Payment[]
  invoices           Invoice[]
  attendances        Attendance[]
  memberOffices      MemberOffice[]
  documentsList      Document[]
  messageLogs        MessageLog[]
  relatives          Relative[]
  user               User?
  hospitalityRequests HospitalityRequest[]
  materialLoans      MaterialLoan[]
  venerableGalleryEntries VenerableGalleryEntry[]
}

// Família e dependentes do membro (mãe, pai, esposa, filhos, outros dependentes).
// Cada um com contatos próprios para envio de felicitações de aniversário.
// Substitui os campos planos (childrenNames/motherName/fatherName/spouse*) — depreciados.
model Relative {
  id        String    @id @default(cuid())
  lodgeId   String
  memberId  String
  kind      String    // mother | father | spouse | child | other
  name      String
  birthDate DateTime?
  cpf       String?
  email     String?
  phone     String?
  deceased  Boolean   @default(false) // falecido — exclui de felicitações de aniversário automáticas
  order     Int       @default(0) // ordem de exibição (mãe→pai→esposa→dependentes)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lodge     Lodge     @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([lodgeId, memberId])
  @@index([lodgeId, birthDate])
}

model Document {
  id           String   @id @default(cuid())
  lodgeId      String
  memberId     String?  // null = documento institucional da loja (Regimento, Regulamento, Constituição), visível a todos os membros
  title        String
  kind         String   @default("document")
  category     String?  @default("general")
  status       String?  @default("draft")
  storageKey   String?
  fileName     String?
  fileUrl      String?
  mimeType     String?
  content      String?
  checksum     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lodge        Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MessageLog {
  id        String   @id @default(cuid())
  lodgeId   String
  memberId  String?
  channel   String
  title     String
  content   String
  status    String   @default("queued")
  // Motivo de queued/failed (ex.: "WhatsApp não conectado nesta loja.",
  // "Resend 429") — o mesmo texto que dispatch() já calculava mas nunca era
  // salvo, obrigando quem investigasse a ler o código-fonte pra descobrir a
  // causa. Null quando status='sent' (nada a explicar).
  error     String?
  createdAt DateTime @default(now())

  lodge     Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model Account {
  id             String   @id @default(cuid())
  lodgeId        String
  memberId       String?
  chartAccountId String?  // vínculo ao plano de contas (livro caixa / balancete)
  counterpartyId String?  // vínculo ao cadastro de cliente/fornecedor (quando não é membro)
  bankAccountId  String?  // conta bancária/caixa PREVISTA (só pré-preenche o pagamento; não é obrigatória)
  sessionId      String?  // sessão do dia em que o lançamento ocorreu (ex.: doação ao Tronco na sessão em curso)
  type           String   // RECEIVABLE | PAYABLE
  title          String
  amount         Float
  dueDate        DateTime
  status         String   @default("pending")
  isDues         Boolean  @default(false) // mensalidade do membro (base da regra dos 60 dias / Art. 002)
  approvalStatus String   @default("approved") // approved | pending | rejected — visto do Venerável (despesas acima do limite)
  description    String?
  // Snapshot do nome/documento da contraparte no momento do lançamento —
  // sobrevive mesmo se o cadastro em Counterparty for editado/removido depois
  // (mesmo padrão de `title` guardar o nome da ChartAccount na hora do lançamento).
  counterpartyName String?
  counterpartyDoc   String? // CPF/CNPJ, quando disponível
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lodge        Lodge        @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  chartAccount ChartAccount? @relation(fields: [chartAccountId], references: [id], onDelete: SetNull)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  bankAccount  FinancialAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  session      Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  payments     Payment[]
  invoices     Invoice[]

  @@index([chartAccountId])
  @@index([counterpartyId])
  @@index([bankAccountId])
  @@index([sessionId])
}

// Cadastro de clientes/fornecedores — contrapartes de Account que não são
// membros da loja (fornecedor de evento, entidade paramaçônica, doador
// avulso, etc.). Um único modelo para os dois papéis (kind), no mesmo
// espírito de ChartAccount.type separar REVENUE/EXPENSE numa tabela só —
// evita duplicar campos idênticos (nome, documento, contato, endereço) em
// duas tabelas quando a única diferença real é o lado da conta (a pagar ou
// a receber). Pensado para ser reaproveitado por qualquer loja.
model Counterparty {
  id          String   @id @default(cuid())
  lodgeId     String
  kind        String   @default("supplier") // client | supplier | both
  name        String                        // nome / nome fantasia
  legalName   String?                       // razão social
  document    String?                       // CPF ou CNPJ
  isCompany   Boolean  @default(false)       // pessoa jurídica (J) vs física (F)
  email       String?
  phone       String?
  addressLine String?
  city        String?
  state       String?
  zipCode     String?
  category    String?                       // categoria livre (ex.: ramo de atividade)
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lodge    Lodge     @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@unique([lodgeId, document])
  @@index([lodgeId, name])
}

model Invoice {
  id                 String   @id @default(cuid())
  lodgeId            String
  accountId          String
  memberId           String?
  number             String
  status             String   @default("pending")
  issuedAt           DateTime @default(now())
  dueDate            DateTime
  amount             Float
  description        String?
  isRecurring        Boolean  @default(false)
  recurringInterval  String?
  recurringCount     Int?
  nextDueDate        DateTime?
  asaasPaymentId     String?  // id da cobrança no Asaas (reconciliação reversa)
  asaasInvoiceUrl    String?  // link universal da cobrança no Asaas (boleto/PIX/cartão), persistido p/ sobreviver a reload
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lodge              Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  member             Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model Payment {
  id           String   @id @default(cuid())
  lodgeId      String
  accountId    String
  memberId     String?
  bankAccountId String? // conta bancária/caixa que efetivamente recebeu/pagou (obrigatório na API p/ pagamentos novos; histórico antigo fica null)
  amount       Float
  paidAt       DateTime @default(now())
  method       String   @default("manual")
  note         String?

  lodge        Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  bankAccount  FinancialAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  bankTransactions BankTransaction[]

  @@index([bankAccountId])
}

// Cadastro das "contas financeiras" da loja — cada banco (com agência/conta,
// podendo ser marcado como conta de investimento) ou o Caixa físico. Permite
// vincular cada pagamento/recebimento a um "bolso" específico da loja (hoje
// tudo cai num pool único) e apurar saldo por conta. Não confundir com
// ChartAccount (categoria contábil receita/despesa) nem com ContaCorrente
// comercial da loja em Lodge.bankName/bankAgency/bankAccount (dado cadastral
// único, não transacional).
model FinancialAccount {
  id             String   @id @default(cuid())
  lodgeId        String
  name           String              // rótulo livre, ex. "Santander CC", "Caixa da Loja"
  kind           String              // bank | cash
  bankName       String?             // nome do banco (lista fixa), só quando kind=bank
  isInvestment   Boolean  @default(false)
  agency         String?
  accountNumber  String?
  openingBalance Float    @default(0)
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lodge         Lodge              @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  accounts      Account[]
  payments      Payment[]
  transfersFrom AccountTransfer[]  @relation("TransferFrom")
  transfersTo   AccountTransfer[]  @relation("TransferTo")

  @@index([lodgeId])
}

// Movimentação de saldo entre duas FinancialAccount da mesma loja (ex.: sacar
// do banco pro caixa). Dupla assinatura: o Tesoureiro cria (status=pending) e
// só entra no cálculo de saldo depois que o Venerável (ou Admin) aprova —
// mesmo modelo de aprovação de Account.approvalStatus (despesas) e
// CashClose.approved (fechamento de veneralato).
model AccountTransfer {
  id           String    @id @default(cuid())
  lodgeId      String
  fromId       String
  toId         String
  amount       Float
  date         DateTime  @default(now())
  note         String?
  status       String    @default("pending") // pending | approved | rejected
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  lodge Lodge            @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  from  FinancialAccount @relation("TransferFrom", fields: [fromId], references: [id], onDelete: Restrict)
  to    FinancialAccount @relation("TransferTo", fields: [toId], references: [id], onDelete: Restrict)

  @@index([lodgeId])
  @@index([fromId])
  @@index([toId])
}

// Patrimônio/inventário da loja — cadastro simples de bens (móveis, insígnias,
// equipamentos), sem depreciação contábil automática. Vínculo opcional à
// categoria "Investimentos" do plano de contas.
model Asset {
  id               String    @id @default(cuid())
  lodgeId          String
  name             String
  description      String?
  category         String?   // ex.: Móveis, Insígnias, Equipamentos, Imóveis
  acquisitionDate  DateTime?
  acquisitionValue Float     @default(0)
  currentValue     Float?    // valor atual estimado (opcional; sem cálculo automático)
  status           String    @default("active") // active | disposed | lost
  chartAccountId   String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lodge        Lodge         @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  chartAccount ChartAccount? @relation(fields: [chartAccountId], references: [id], onDelete: SetNull)

  @@index([lodgeId])
}

// Inventário patrimonial de uso geral da loja (mobiliário, ornamentos,
// indumentária, alfaias, rituais) — cadastro operacional por QUANTIDADE em
// estoque. Distinto do Asset acima (registro financeiro/depreciação por
// unidade, usado pelo Tesoureiro) — um item pode existir nos dois cadastros
// sem relação entre eles; este aqui é do Secretário/Arquiteto, sem viés
// contábil.
model Material {
  id             String    @id @default(cuid())
  lodgeId        String
  riteId         String?   // opcional: item específico de um rito; null = genérico/qualquer rito
  name           String
  category       String?   // livre, sugerida por datalist (ver MATERIAL_CATEGORIES)
  requiredDegree String?   // 'Aprendiz'|'Companheiro'|'Mestre'|'Mestre Instalado'; null = sem exigência de grau
  quantity       Int       @default(1)
  notes          String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lodge          Lodge          @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  rite           Rite?          @relation(fields: [riteId], references: [id], onDelete: SetNull)
  loans          MaterialLoan[]

  @@unique([lodgeId, name])
  @@index([lodgeId, category])
}

// Fornecimento/empréstimo de um Material a um Membro (ex.: "Fornecimento de
// Rituais — Irmão Fulano"). Genérico: serve para rituais, aventais, joias
// etc. Disponível = Material.quantity − soma dos empréstimos com status
// 'issued' (calculado em runtime, não armazenado).
model MaterialLoan {
  id           String    @id @default(cuid())
  lodgeId      String
  materialId   String
  memberId     String
  quantity     Int       @default(1)
  status       String    @default("issued") // issued | returned | lost
  issuedAt     DateTime  @default(now())
  returnedAt   DateTime?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lodge    Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([lodgeId, materialId])
  @@index([lodgeId, memberId])
  @@index([lodgeId, status])
}

// Linha importada de extrato bancário (OFX/CSV), pra conciliar com os
// Payments já lançados no sistema. amount > 0 = crédito (entrada), < 0 =
// débito (saída) — segue a convenção do próprio extrato.
model BankTransaction {
  id               String    @id @default(cuid())
  lodgeId          String
  date             DateTime
  description      String
  amount           Float
  externalId       String?   // FITID do OFX, quando houver (evita duplicar em reimportações)
  status           String    @default("unmatched") // unmatched | matched | ignored
  matchedPaymentId String?
  importedAt       DateTime  @default(now())

  lodge          Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  matchedPayment Payment? @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)

  @@index([lodgeId])
}

model Subscription {
  id              String   @id @default(cuid())
  lodgeId         String   @unique
  stripeSubscriptionId String? @unique
  stripeCustomerId String?
  stripeScheduleId String?  // schedule de downgrade agendado (Stripe)
  plan            String   @default("oficina")
  // status: trialing | active | past_due | inactive | canceled
  status          String   @default("inactive")
  billingInterval String   @default("month") // month | year
  paymentMethod   String?  // card | pix | boleto
  trialEndsAt     DateTime?
  // Downgrade agendado para o fim do período vigente (sem reembolso)
  pendingPlan     String?
  pendingPlanEffectiveAt DateTime?
  memberCount     Int      @default(0)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lodge           Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
}

// Convite de acesso (cadastro de teste somente por convite).
model Invitation {
  id          String   @id @default(cuid())
  code        String   @unique
  email       String?  // opcional: convite direcionado a um e-mail
  note        String?  // referência interna (ex.: nome da loja/contato)
  // status: pending | used | revoked | expired
  status      String   @default("pending")
  plan        String?  // override do plano do trial (ex.: "loja"); null = padrão (Oficina)
  trialDays   Int?     // override da duração do trial em dias; null = padrão (TRIAL_DAYS)
  lodgeId     String?  // preenchido quando o convite é consumido
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// Histórico de execuções do backup completo da plataforma (todas as lojas).
// Tabela de plataforma (sem RLS) — só escrita/lida via prismaAdmin, pelo cron
// de backup e pelo painel /plataforma/backups.
model BackupLog {
  id          String   @id @default(cuid())
  storageKey  String?  // chave no R2 (null quando status = failed antes do upload)
  status      String   // success | failed
  sizeBytes   Int?
  totalRows   Int?
  modelCounts String?  // JSON: { "Member": 12, "Account": 34, ... }
  durationMs  Int?
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  lodgeId      String
  userId       String?
  action       String
  entity       String
  entityId     String
  before       String?
  after        String?
  createdAt    DateTime @default(now())

  lodge        Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Session {
  id        String   @id @default(cuid())
  lodgeId   String
  title     String
  date      DateTime
  endDate   DateTime? // término da sessão — presença só pode ser marcada depois deste horário (sessões antigas sem este campo não são bloqueadas)
  type      String   @default("ordinary")
  grade     String?
  notes     String?  // anotações internas do Secretário, não visível ao obreiro
  agenda    String?  // ordem do dia — visível ao obreiro antes da sessão (Secretaria)
  minutes   String?  // DEPRECADO: balaustre digitado direto; substituído pelo upload de arquivo abaixo
  // Balaustre/ata como arquivo importado (PDF/Word) — bucket privado de Documentos,
  // baixado por URL assinada de curta duração (nunca público). Visível a todos os
  // membros ao revisitar a sessão.
  minutesStorageKey String?
  minutesFileName   String?
  minutesMimeType   String?
  convocationSentAt   DateTime? // quando o chamado foi enviado por e-mail a todos
  convocationSentById String?
  // Trava a sessão contra edição (agenda, presença, balaustre) — travada
  // automaticamente ao salvar o balaustre; só Administrador/Venerável destranca.
  locked     Boolean   @default(false)
  lockedAt   DateTime?
  lockedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge      Lodge       @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  accounts   Account[]
}

// Pedido leve do obreiro à Hospitalaria (proposta de campanha ou solicitação
// de auxílio) — só notifica o Hospitaleiro por mensagem; não vira Campaign
// sozinho, quem decide formalizar é a própria Hospitalaria.
model HospitalityRequest {
  id          String   @id @default(cuid())
  lodgeId     String
  memberId    String
  title       String
  description String?
  status      String   @default("pending") // pending | reviewed
  createdAt   DateTime @default(now())

  lodge  Lodge  @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([lodgeId])
}

model Attendance {
  id        String   @id @default(cuid())
  lodgeId   String
  sessionId String
  memberId  String
  status    String   @default("present")
  notes     String?
  createdAt DateTime @default(now())

  lodge     Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@index([lodgeId])
}

model Office {
  id        String   @id @default(cuid())
  lodgeId   String
  riteId    String?
  name      String
  order     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge        Lodge          @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  rite         Rite?          @relation(fields: [riteId], references: [id], onDelete: SetNull)
  memberOffices MemberOffice[]

  @@unique([lodgeId, riteId, name])
}

model Rite {
  id        String   @id @default(cuid())
  lodgeId   String
  name      String
  order     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge     Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  members   Member[]
  offices   Office[]
  materials Material[]
}

model Term {
  id        String   @id @default(cuid())
  lodgeId   String
  title     String
  startDate DateTime
  endDate   DateTime?
  status    String   @default("active") // active | closed
  notes     String?
  openingBalance Float    @default(0)  // saldo de caixa herdado da gestão anterior
  closedAt       DateTime?             // encerramento do veneralato (após prestação aprovada)
  closedById     String?               // usuário (Admin) que encerrou
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge        Lodge          @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  memberOffices MemberOffice[]
  cashCloses   CashClose[]
}

model MemberOffice {
  id        String   @id @default(cuid())
  lodgeId   String
  memberId  String
  officeId  String
  termId    String
  createdAt DateTime @default(now())

  lodge     Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([memberId, officeId, termId])
  @@index([lodgeId])
}

// Entradas manuais da Galeria de Veneráveis — cobre Veneráveis históricos que a
// loja não tem cadastrados como Member (atas antigas, placas na parede). As
// entradas "automáticas" (a partir de MemberOffice/Term) não usam este model.
model VenerableGalleryEntry {
  id              String   @id @default(cuid())
  lodgeId         String
  name            String
  photoUrl        String?  // usada só quando memberId é nulo (sem cadastro pra herdar foto)
  photoStorageKey String?
  periodLabel     String   // texto livre: "1985–1987", "1998 a 2000" etc.
  sortDate        DateTime // só para ordenar a linha do tempo (ex.: 1º jan do ano de início)
  notes           String?
  // Vincula a um Member já cadastrado (ex.: veneralato antigo sem Term/cargo
  // registrado no sistema, mas a pessoa já é membro) — quando preenchido, a
  // galeria exibe sempre a foto atual do cadastro do membro, nunca uma foto
  // própria da entrada (mesma fonte única usada pelas entradas automáticas).
  memberId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lodge  Lodge   @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([lodgeId])
  @@index([memberId])
}

model CashClose {
  id          String   @id @default(cuid())
  lodgeId     String
  termId      String
  closedAt    DateTime @default(now())
  totalReceivables Float  @default(0)
  totalPayables    Float  @default(0)
  totalPayments    Float  @default(0)
  netBalance       Float  @default(0)
  openingBalance   Float  @default(0)  // saldo herdado no início do período
  closingBalance   Float  @default(0)  // saldo final = abertura + entradas − saídas
  approved         Boolean  @default(false) // prestação de contas aprovada (Venerável)
  approvedAt       DateTime?
  approvedById     String?
  notes       String?
  createdAt   DateTime @default(now())

  lodge       Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  term        Term     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([lodgeId, termId])
}

// Balancete periódico (trimestral/semestral) apresentado em sessão, exigido
// pelo regulamento independente do encerramento do veneralato inteiro — mais
// leve que o CashClose (não trava período nem depende de um Term específico).
model Balancete {
  id               String    @id @default(cuid())
  lodgeId          String
  periodFrom       DateTime
  periodTo         DateTime
  totalReceivables Float     @default(0)
  totalPayables    Float     @default(0)
  totalPayments    Float     @default(0)
  netBalance       Float     @default(0)
  presentedAt      DateTime  @default(now()) // data da sessão em que foi apresentado
  approved         Boolean   @default(false) // aprovado pela Loja/Venerável em sessão
  approvedAt       DateTime?
  approvedById     String?
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())

  lodge Lodge @relation(fields: [lodgeId], references: [id], onDelete: Cascade)

  @@index([lodgeId])
}

model Power {
  id        String   @id @default(cuid())
  lodgeId   String
  name      String
  order     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge     Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  members       Member[] @relation("MemberPower")
  originMembers Member[] @relation("MemberOriginPower")
}

// Plano de contas da loja (categorias de receita/despesa). Semeado por padrão
// com as contas típicas de uma loja maçônica (captações, taxas de grau, aluguel...).
model ChartAccount {
  id        String   @id @default(cuid())
  lodgeId   String
  code      String
  name      String
  type      String   // REVENUE | EXPENSE
  category  String?
  active    Boolean  @default(true)
  isSolidarity Boolean @default(false) // conta do Tronco de Solidariedade (benemerência)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge     Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  accounts  Account[]
  budgets   Budget[]
  assets    Asset[]

  @@unique([lodgeId, code])
}

// Orçamento anual por categoria do plano de contas: meta definida no início da
// gestão, comparada ao realizado (soma das Account por vencimento no ano).
model Budget {
  id             String   @id @default(cuid())
  lodgeId        String
  year           Int
  chartAccountId String
  plannedAmount  Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lodge        Lodge        @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  chartAccount ChartAccount @relation(fields: [chartAccountId], references: [id], onDelete: Cascade)

  @@unique([lodgeId, year, chartAccountId])
  @@index([lodgeId])
}

// Campanha de benemerência da Hospitalaria (ex.: cadeira de rodas, cesta básica).
model Campaign {
  id              String   @id @default(cuid())
  lodgeId         String
  title           String
  description     String?
  beneficiaryType String   // person | company | institution
  beneficiaryName String?
  goalAmount      Float?
  fundingSource   String   @default("donations") // fund | donations | mixed
  fundAllocated   Float    @default(0) // valor custeado pelo Tronco
  status          String   @default("active") // active | completed | canceled
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lodge     Lodge              @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  donations CampaignDonation[]

  @@index([lodgeId])
}

// Doação voluntária captada para uma campanha. O nome do doador pode ser ocultado.
model CampaignDonation {
  id         String   @id @default(cuid())
  lodgeId    String
  campaignId String
  donorName  String?
  anonymous  Boolean  @default(false)
  amount     Float
  receivedAt DateTime @default(now())
  note       String?
  paymentId  String?  // lançamento financeiro vinculado (Tronco)
  createdAt  DateTime @default(now())

  lodge    Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([lodgeId, campaignId])
}

// RBAC persistido por loja: matriz papel × recurso × ação.
// Substitui o roleMap fixo em código — cada loja pode ajustar suas permissões.
// Se uma loja não tiver linhas, o sistema usa os padrões de src/lib/rbac.ts (DEFAULT_POLICY).
model RolePermission {
  id        String   @id @default(cuid())
  lodgeId   String
  role      String   // admin | venerable | treasurer | secretary | member
  resource  String   // members | documents | messages | accounts | portal
  action    String   // read | write
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lodge     Lodge    @relation(fields: [lodgeId], references: [id], onDelete: Cascade)

  @@unique([lodgeId, role, resource, action])
  @@index([lodgeId])
}
